# EP (Endpoint) controllers for UBCC basic framework

Import('*')

import os

if env['CONF']['PROTOCOL'] != 'CHI':
    Return()

repo_root = os.path.abspath(os.path.join(Dir('#').abspath, '..'))
zmq_include = os.path.join(repo_root, 'thirdparty/zeromq/include')
zmq_lib = os.path.join(repo_root, 'thirdparty/zeromq/lib')

# Framework is now built externally by scripts/build_framework.sh into
# build/framework/{lib,include}. gem5 links the prebuilt libframework.a
# instead of compiling framework/Port.cc in-tree.
fw_prefix = os.path.join(repo_root, 'build', 'framework')
fw_lib = os.path.join(fw_prefix, 'lib', 'libframework.a')
if not os.path.isfile(fw_lib):
    raise SCons.Errors.StopError(
        'libframework.a not found at %s. Run scripts/build_framework.sh first.' % fw_lib)

env.Append(CPPPATH=[repo_root, zmq_include, os.path.join(fw_prefix, 'include')])
env.Append(LIBPATH=[zmq_lib, os.path.join(fw_prefix, 'lib')])
env.Append(LIBS=['framework', 'zmq'])
env.Append(LINKFLAGS=['-pthread', f'-Wl,-rpath,{zmq_lib}'])

SimObject('EPController.py', sim_objects=['EPController'])
SimObject('EPRNFController.py', sim_objects=['EPRNFController'])
SimObject('EPSNFController.py', sim_objects=['EPSNFController'])
SimObject('EPBackend.py', sim_objects=['EPBackend'])
SimObject('MetaRNFController.py', sim_objects=['MetaRNFController'])
SimObject('UBAdapter.py', sim_objects=['UBAdapter'])

Source('EPRNFController.cc')
Source('EPSNFController.cc')
Source('EPBackend.cc')
Source('MetaRNFController.cc')
Source('UBAdapter.cc')
Source('NodeAddressMap.cc')
Source('BackstoreSchemaA.cc')
Source('BackstoreSchemaC.cc')
Source('M4SelfTest.cc')
Source('M5SelfTest.cc')
Source('M6SelfTest.cc')
Source('M7SelfTest.cc')
Source('M8SelfTest.cc')
# framework/Port.cc is now linked via build/framework/lib/libframework.a (above)

DebugFlag('RubyEP')
DebugFlag('RubyEPVerbose')
DebugFlag('UBLatency')
DebugFlag('UBInvariant')
