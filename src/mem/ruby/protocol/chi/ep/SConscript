# EP (Endpoint) controllers for UBCC basic framework

Import('*')

import os
import shlex
import SCons.Errors

if env['CONF']['PROTOCOL'] != 'CHI':
    Return()

repo_root = os.path.abspath(os.path.join(Dir('#').abspath, '..'))
zmq_include = os.path.join(repo_root, 'thirdparty', 'zeromq', 'include')
zmq_lib = os.path.join(repo_root, 'thirdparty', 'zeromq', 'lib')

# gem5 always sees the frozen iface headers and links the selected opaque
# backend.  Relative archive paths are resolved against the workspace root.
fw_backend = os.environ.get('FRAMEWORK_BACKEND', 'local')
fw_prefix = os.path.join(repo_root, 'build', 'framework')
fw_include = os.path.join(fw_prefix, 'include')
fw_lib_value = os.environ.get(
    'FRAMEWORK_BACKEND_LIB',
    os.path.join('build', 'framework', 'lib',
                 'libframework_%s.a' % fw_backend))
fw_lib = (fw_lib_value if os.path.isabs(fw_lib_value)
          else os.path.join(repo_root, fw_lib_value))
fw_lib = os.path.normpath(fw_lib)
if not os.path.isfile(fw_lib):
    raise SCons.Errors.StopError(
        "framework backend '%s' archive not found at %s. Build/provide it "
        'and set FRAMEWORK_BACKEND_LIB to an absolute or workspace-relative archive.' %
        (fw_backend, fw_lib))

env.Append(CPPPATH=[repo_root, fw_include])
if fw_backend == 'local':
    env.Append(CPPPATH=[zmq_include])
    env.Append(LIBPATH=[zmq_lib])

# Put the backend archive before its dependency libraries.  Parse environment
# flags with shlex rather than evaluating shell text.
env.Append(LIBS=[File(fw_lib)])
if fw_backend == 'local':
    env.Append(LIBS=['zmq'])
    env.Append(LINKFLAGS=['-pthread', '-Wl,-rpath,%s' % zmq_lib])

backend_cppflags = shlex.split(
    os.environ.get('FRAMEWORK_BACKEND_CPPFLAGS', ''))
backend_ldflags = shlex.split(
    os.environ.get('FRAMEWORK_BACKEND_LDFLAGS', ''))
if backend_cppflags:
    env.MergeFlags(backend_cppflags)
if backend_ldflags:
    env.MergeFlags(backend_ldflags)

SimObject('EPController.py', sim_objects=['EPController'])
SimObject('EPRNFController.py', sim_objects=['EPRNFController'])
SimObject('EPSNFController.py', sim_objects=['EPSNFController'])
SimObject('EPBackend.py', sim_objects=['EPBackend'])
SimObject('MetaRNFController.py', sim_objects=['MetaRNFController'])
SimObject('UBAdapter.py', sim_objects=['UBAdapter'])

Source('EPRNFController.cc')
Source('EPSNFController.cc')
Source('EPBackend.cc')
Source('MetaRNFController.cc')
Source('UBAdapter.cc')
Source('NodeAddressMap.cc')
Source('M4SelfTest.cc')
Source('M5SelfTest.cc')
Source('M6SelfTest.cc')
Source('M7SelfTest.cc')
Source('M8SelfTest.cc')
Source('M9SelfTest.cc')
# The opaque framework implementation is linked from the selected backend.

DebugFlag('RubyEP')
DebugFlag('RubyEPVerbose')
DebugFlag('UBLatency')
DebugFlag('UBInvariant')
